rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActiveUser() {
      return isSignedIn() && userDoc().active == true;
    }
    function hasRole(roles) {
      return isActiveUser() && (userDoc().role in roles);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || hasRole(['teacher', 'admin']));
      allow create, update: if hasRole(['teacher', 'admin']);
      allow delete: if hasRole(['admin']);
    }

    match /news/{newsId} {
      allow read: if resource.data.status == 'published' || hasRole(['officer', 'teacher', 'admin']);
      allow create, update, delete: if hasRole(['officer', 'teacher', 'admin']);
    }

    match /events/{eventId} {
      allow read: if resource.data.published == true || hasRole(['officer', 'teacher', 'admin']);
      allow create, update, delete: if hasRole(['officer', 'teacher', 'admin']);
    }

    match /progress/{progressId} {
      allow read: if resource.data.published == true || hasRole(['officer', 'teacher', 'admin']);
      allow create, update, delete: if hasRole(['officer', 'teacher', 'admin']);
    }

    match /petitions/{petitionId} {
      allow read: if resource.data.published == true || hasRole(['officer', 'teacher', 'admin']);
      allow create: if isActiveUser()
        && request.resource.data.proposerUid == request.auth.uid
        && request.resource.data.signatureCount == 0
        && request.resource.data.published == false;
      allow update: if hasRole(['officer', 'teacher', 'admin'])
        || (isActiveUser()
            && resource.data.published == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signatureCount', 'updatedAt'])
            && request.resource.data.signatureCount == resource.data.signatureCount + 1);
      allow delete: if hasRole(['teacher', 'admin']);
    }

    match /signatures/{sigId} {
      allow read: if isSignedIn() && (resource.data.userUid == request.auth.uid || hasRole(['officer', 'teacher', 'admin']));
      allow create: if isActiveUser()
        && sigId == request.resource.data.petitionId + '_' + request.auth.uid
        && request.resource.data.userUid == request.auth.uid
        && !exists(/databases/$(database)/documents/signatures/$(sigId));
      allow update, delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if isActiveUser() && request.resource.data.senderUid == request.auth.uid;
      allow read, update: if hasRole(['officer', 'teacher', 'admin']);
      allow delete: if hasRole(['teacher', 'admin']);
    }

    match /schoolRules/{ruleId} {
      allow read: if resource.data.status == 'approved' || hasRole(['officer', 'teacher', 'admin']);
      allow create: if hasRole(['officer', 'teacher', 'admin']) && request.resource.data.status != 'approved';
      allow update: if hasRole(['teacher', 'admin'])
        || (hasRole(['officer']) && request.resource.data.status != 'approved' && resource.data.status != 'approved');
      allow delete: if hasRole(['teacher', 'admin']);
    }

    match /auditLogs/{logId} {
      allow create: if hasRole(['officer', 'teacher', 'admin']);
      allow read: if hasRole(['teacher', 'admin']);
      allow update, delete: if false;
    }

    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if hasRole(['teacher', 'admin']);
    }
  }
}
